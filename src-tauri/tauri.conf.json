{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReallyNoted",
  "version": "0.1.0",
  "identifier": "com.notey.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ReallyNoted",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:*; connect-src 'self' http://localhost:* https:; media-src 'self' blob:; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Office",
    "shortDescription": "Local-first notes and transcription",
    "longDescription": "Private notes, local audio recording, transcription, and AI summaries.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
